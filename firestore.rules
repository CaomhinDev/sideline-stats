rules_version = '2';

// Sideline Stats access rules.
// - Only Google accounts listed in /allow/{email} (the coaches) can use the app at
//   all. The list is managed in the Firebase console; coaches can see it but the
//   app can never change it.
// - Your squad lives in /users/{uid}; only you can change it. If you share your
//   team, every coach can view it (and all your games are shared).
// - Each game is /games/{uid}_{id}. Its creator controls it. If marked shared,
//   every coach can view it. Coaches listed in its `editors` can also edit the
//   game itself (events, clock, subs), but not who can edit, sharing, or delete.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function allowed() {
      return signedIn() && exists(/databases/$(database)/documents/allow/$(email()));
    }

    function isOwner(data) {
      return data.owner == request.auth.uid;
    }

    function isEditor(data) {
      return email() in data.get('editors', []);
    }

    match /allow/{address} {
      allow get: if signedIn() && address == email();
      allow list: if allowed();
      allow write: if false;
    }

    // Your squad. If you share your team, coaches can read it (never change it).
    match /users/{uid} {
      allow read: if allowed() && (request.auth.uid == uid || resource.data.shared == true);
      allow write: if allowed() && request.auth.uid == uid;
    }

    match /games/{gameId} {
      allow read: if allowed()
        && (isOwner(resource.data) || resource.data.shared == true || isEditor(resource.data));
      allow create: if allowed()
        && isOwner(request.resource.data)
        && gameId.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.shared is bool
        && request.resource.data.get('editors', []) is list;
      // The owner can change anything except handing the game to someone else.
      // An editor can only change the game itself (and its timestamp).
      allow update: if allowed() && (
        (isOwner(resource.data)
          && isOwner(request.resource.data)
          && request.resource.data.shared is bool
          && request.resource.data.get('editors', []) is list)
        || (isEditor(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game', 'updated'])
          && request.resource.data.game.id == resource.data.game.id)
      );
      allow delete: if allowed() && isOwner(resource.data);
    }

    // Anything else: no access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
