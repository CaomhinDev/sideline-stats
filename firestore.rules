rules_version = '2';

// Sideline Stats access rules.
// - Only Google accounts listed in /allow/{email} can use the app at all. That list
//   is managed in the Firebase console (it is never readable or writable by the app,
//   except that you can check your own entry).
// - Your squad lives in /users/{uid}; only you can change it. If you share your
//   team, everyone on the allowlist can view it (and all your games are shared).
// - Each game is /games/{uid}_{id}. Only its creator can change it. If the creator
//   marks it shared, everyone on the allowlist can view it (read only).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function allowed() {
      return signedIn() && exists(/databases/$(database)/documents/allow/$(email()));
    }

    function isOwner(data) {
      return data.owner == request.auth.uid;
    }

    match /allow/{address} {
      allow get: if signedIn() && address == email();
      allow list, write: if false;
    }

    // Your squad. If you share your team, family can read it (never change it).
    match /users/{uid} {
      allow read: if allowed() && (request.auth.uid == uid || resource.data.shared == true);
      allow write: if allowed() && request.auth.uid == uid;
    }

    match /games/{gameId} {
      allow read: if allowed() && (isOwner(resource.data) || resource.data.shared == true);
      allow create: if allowed()
        && isOwner(request.resource.data)
        && gameId.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.shared is bool;
      allow update: if allowed()
        && isOwner(resource.data)
        && isOwner(request.resource.data)
        && request.resource.data.shared is bool;
      allow delete: if allowed() && isOwner(resource.data);
    }

    // Anything else: no access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
